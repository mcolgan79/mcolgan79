# OptPoP web monetization — copy to `.env` for local dev, and set the same
# VITE_* vars in your host's build settings (e.g. Cloudflare Pages → Env).
# Everything is optional: unset vars make ads fall back to placeholders and
# checkout fall back to the local mock, so the app always builds and runs.

# --- AdSense (client-side; these values are public) ---
VITE_ADSENSE_CLIENT=ca-pub-0000000000000000
VITE_ADSENSE_SLOT_TOP=0000000000
VITE_ADSENSE_SLOT_BOTTOM=0000000000

# --- Stripe (client flag only; publishable key is safe to expose) ---
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# --- Server-only (NEVER prefix with VITE_; set as backend/function secrets) ---
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_PRICE_ID=price_xxx
# PUBLIC_BASE_URL=https://your-optpop-domain.example
