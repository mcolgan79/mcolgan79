# Copy to .env (gitignored) and fill in your Alpaca PAPER keys.
# Get them at https://app.alpaca.markets/paper/dashboard/overview -> "API Keys"
APCA_API_KEY_ID=your_paper_key_id
APCA_API_SECRET_KEY=your_paper_secret_key

# Optional: override the endpoint. Defaults to the paper endpoint.
# APCA_API_BASE_URL=https://paper-api.alpaca.markets
